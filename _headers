# Cloudflare Pages — headers por rota.
# Páginas de teste e rascunhos: fora dos buscadores em qualquer formato
# servido (o X-Robots-Tag cobre também assets, que não têm <meta>).
/teste/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# As páginas do Manual (lt-v1-27, -67 e -97) saíram do noindex em
# 29/09/2026: estão publicadas e podem ser indexadas. Não há regra para
# elas aqui — ausência é permissão.

# Páginas de funil do Método Mãos Lucrativas (upsell, downsell e a
# conclusão do pedido): só devem ser alcançadas dentro do fluxo de compra,
# nunca pela busca.
#
# Cada etapa tem uma cópia por ticket do Manual — <etapa>-27, -67 e -97 —,
# para dar uma URL a cada funil e separar tráfego por preço. O curinga
# cobre as três de uma vez.
#
# Estas continuam fora dos buscadores por natureza, não por serem
# rascunho: são páginas de pós-compra, e uma delas encontrada na busca
# entregaria a oferta a quem não comprou.
/upsell1-mml-*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/upsell2-mml-*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/up-down-mml-*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# Página de venda do Método Mãos Lucrativas, refeita a partir da versão em
# topcorpus.com.br/metodo-maos-lucrativas-v1. Fora dos buscadores enquanto
# as duas existirem: indexadas as duas, elas disputariam a mesma busca e o
# Google escolheria sozinho qual mostrar.
/mml-v1/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# Páginas internas de apoio — o índice das rotas e o fluxograma dos
# funis. Nunca devem ser encontradas na busca.
/indice/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/fluxo/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# Página de pós-compra do Manual: só é alcançada por quem acabou de pagar.
/confirmacao/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
