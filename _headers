# Cloudflare Pages — headers por rota.
# Páginas de teste e rascunhos: fora dos buscadores em qualquer formato
# servido (o X-Robots-Tag cobre também assets, que não têm <meta>).
/teste/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# As páginas do Manual seguem o padrão lt-v1-<ticket>: uma por preço da
# Hotmart (27, 67 e 97), cada uma com sua própria dobra de ancoragem.
# O curinga cobre as três de uma vez, inclusive os assets de cada uma.
# São rascunhos em revisão (sem as imagens); remover este bloco quando
# forem publicadas de verdade.
/lt-v1-*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# Páginas de funil do Método Mãos Lucrativas (upsell e o downsell dele):
# só devem ser alcançadas dentro do fluxo de compra, nunca pela busca.
/upsell1-mml/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/upsell2-mml/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/up-down-mml/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# Índice interno das páginas, na raiz. Nunca deve ser encontrado na busca.
/
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/index.html
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
